      "interpreterVersion": 1,
      "code": "// as edges\nfunction run(\n  shape: Assembly,\n) {\n  let edges: replicad.Edge[] = []\n  shape.onLeafs((leaf) => {\n    if (leaf.is3D() || leaf.geometry instanceof replicad.Wire) {\n      edges.push(...leaf.geometry.edges)\n    } else {\n      return undefined\n    }\n    return leaf;\n  })\n  console.log(edges.map((e) => e.orientation))\n  edges = sortEdgesByContinuity(edges, 0.001)\n  //  return replicad.assembleWire([edges[2], edges[3], edges[0], edges[1]])\n  return replicad.assembleWire(edges);\n}\n\nimport type { Edge } from \"replicad\";\n\ntype Tuple3 = readonly [number, number, number];\n\n/**\n * Sort a collection of replicad Edges so that each edge's endPoint matches the\n * next edge's startPoint (flipping orientation when necessary).\n *\n * - Starts from an edge whose startPoint is shared by no other edge's endPoint.\n * - If no such start exists (closed loop), starts with edges[0].\n * - Throws if any vertex is shared by more than two edges.\n * - Throws if the edges are not fully connected into a single chain.\n *\n * @param edges     Input edges in arbitrary order.\n * @param tolerance Distance under which two points are considered equal.\n */\nexport function sortEdgesByContinuity(\n  edges: Edge[],\n  tolerance = 1e-6,\n): Edge[] {\n  if (edges.length <= 1) return edges.slice();\n\n  const tol2 = tolerance * tolerance;\n\n  const dist2 = (a: Tuple3, b: Tuple3): number => {\n    const dx = a[0] - b[0];\n    const dy = a[1] - b[1];\n    const dz = a[2] - b[2];\n    return dx * dx + dy * dy + dz * dz;\n  };\n  const eq = (a: Tuple3, b: Tuple3): boolean => dist2(a, b) <= tol2;\n\n  // Cache endpoint tuples so we only query replicad once per edge.\n  type EndpointInfo = { edge: Edge; start: Tuple3; end: Tuple3 };\n  const infos: EndpointInfo[] = edges.map((edge) => ({\n    edge,\n    start: edge.startPoint.toTuple() as Tuple3,\n    end: edge.endPoint.toTuple() as Tuple3,\n  }));\n\n  // Bucket endpoint tuples into equivalence classes under the tolerance.\n  type VertexNode = { point: Tuple3; incidences: number };\n  const nodes: VertexNode[] = [];\n  const findOrAddNode = (p: Tuple3): VertexNode => {\n    for (const n of nodes) {\n      if (eq(n.point, p)) return n;\n    }\n    const n: VertexNode = { point: p, incidences: 0 };\n    nodes.push(n);\n    return n;\n  };\n\n  // Per-edge vertex nodes and per-node incidence count for validation.\n  const edgeNodes = infos.map((info) => {\n    const s = findOrAddNode(info.start);\n    const e = findOrAddNode(info.end);\n    s.incidences++;\n    e.incidences++;\n    return { start: s, end: e };\n  });\n\n  for (const n of nodes) {\n    if (n.incidences > 2) {\n      throw new Error(\n        `Vertex (${n.point.join(\", \")}) is shared by ${n.incidences} edge endpoints; expected at most 2.`,\n      );\n    }\n  }\n\n  // Find a starting edge: one whose start vertex has no other edge's end at it.\n  let startIdx = -1;\n  for (let i = 0; i < infos.length; i++) {\n    const sv = edgeNodes[i].start;\n    let hasIncomingEnd = false;\n    for (let j = 0; j < infos.length; j++) {\n      if (j === i) continue;\n      if (edgeNodes[j].end === sv) {\n        hasIncomingEnd = true;\n        break;\n      }\n    }\n    if (!hasIncomingEnd) {\n      startIdx = i;\n      break;\n    }\n  }\n\n  // If no forward-oriented start, look for an edge whose end vertex is a\n  // degree-1 terminus and flip it into place.\n  let startFlipped = false;\n  if (startIdx === -1) {\n    for (let i = 0; i < infos.length; i++) {\n      const ev = edgeNodes[i].end;\n      const evTouchedElsewhere = infos.some(\n        (_, j) =>\n          j !== i &&\n          (edgeNodes[j].start === ev || edgeNodes[j].end === ev),\n      );\n      if (!evTouchedElsewhere) {\n        startIdx = i;\n        startFlipped = true;\n        break;\n      }\n    }\n  }\n\n  // Closed loop: no terminus. Just start from edge 0.\n  if (startIdx === -1) startIdx = 0;\n\n  const used = new Array<boolean>(infos.length).fill(false);\n  const result: Edge[] = [];\n\n  const firstEdge = startFlipped\n    ? infos[startIdx].edge.flipOrientation()\n    : infos[startIdx].edge;\n  let currentEndPoint: Tuple3 = startFlipped\n    ? infos[startIdx].start\n    : infos[startIdx].end;\n  result.push(firstEdge);\n  used[startIdx] = true;\n\n  while (result.length < infos.length) {\n    let nextIdx = -1;\n    let flip = false;\n    for (let i = 0; i < infos.length; i++) {\n      if (used[i]) continue;\n      if (eq(infos[i].start, currentEndPoint)) {\n        nextIdx = i;\n        flip = false;\n        break;\n      }\n      if (eq(infos[i].end, currentEndPoint)) {\n        nextIdx = i;\n        flip = true;\n        break;\n      }\n    }\n\n    if (nextIdx === -1) {\n      throw new Error(\n        \"Edges are not fully connected: could not find a continuation from \" +\n        `(${currentEndPoint.join(\", \")}).`,\n      );\n    }\n\n    const info = infos[nextIdx];\n    result.push(flip ? info.edge.flipOrientation() : info.edge);\n    currentEndPoint = flip ? info.start : info.end;\n    used[nextIdx] = true;\n  }\n\n  return result;\n}\n",
      "compiledCode": "// as edges\nfunction run(shape) {\n    let edges = [];\n    shape.onLeafs((leaf) => {\n        if (leaf.is3D() || leaf.geometry instanceof replicad.Wire) {\n            edges.push(...leaf.geometry.edges);\n        }\n        else {\n            return undefined;\n        }\n        return leaf;\n    });\n    console.log(edges.map((e) => e.orientation));\n    edges = sortEdgesByContinuity(edges, 0.001);\n    //  return replicad.assembleWire([edges[2], edges[3], edges[0], edges[1]])\n    return replicad.assembleWire(edges);\n}\n/**\n * Sort a collection of replicad Edges so that each edge's endPoint matches the\n * next edge's startPoint (flipping orientation when necessary).\n *\n * - Starts from an edge whose startPoint is shared by no other edge's endPoint.\n * - If no such start exists (closed loop), starts with edges[0].\n * - Throws if any vertex is shared by more than two edges.\n * - Throws if the edges are not fully connected into a single chain.\n *\n * @param edges     Input edges in arbitrary order.\n * @param tolerance Distance under which two points are considered equal.\n */\nexport function sortEdgesByContinuity(edges, tolerance = 1e-6) {\n    if (edges.length <= 1)\n        return edges.slice();\n    const tol2 = tolerance * tolerance;\n    const dist2 = (a, b) => {\n        const dx = a[0] - b[0];\n        const dy = a[1] - b[1];\n        const dz = a[2] - b[2];\n        return dx * dx + dy * dy + dz * dz;\n    };\n    const eq = (a, b) => dist2(a, b) <= tol2;\n    const infos = edges.map((edge) => ({\n        edge,\n        start: edge.startPoint.toTuple(),\n        end: edge.endPoint.toTuple(),\n    }));\n    const nodes = [];\n    const findOrAddNode = (p) => {\n        for (const n of nodes) {\n            if (eq(n.point, p))\n                return n;\n        }\n        const n = { point: p, incidences: 0 };\n        nodes.push(n);\n        return n;\n    };\n    // Per-edge vertex nodes and per-node incidence count for validation.\n    const edgeNodes = infos.map((info) => {\n        const s = findOrAddNode(info.start);\n        const e = findOrAddNode(info.end);\n        s.incidences++;\n        e.incidences++;\n        return { start: s, end: e };\n    });\n    for (const n of nodes) {\n        if (n.incidences > 2) {\n            throw new Error(`Vertex (${n.point.join(\", \")}) is shared by ${n.incidences} edge endpoints; expected at most 2.`);\n        }\n    }\n    // Find a starting edge: one whose start vertex has no other edge's end at it.\n    let startIdx = -1;\n    for (let i = 0; i < infos.length; i++) {\n        const sv = edgeNodes[i].start;\n        let hasIncomingEnd = false;\n        for (let j = 0; j < infos.length; j++) {\n            if (j === i)\n                continue;\n            if (edgeNodes[j].end === sv) {\n                hasIncomingEnd = true;\n                break;\n            }\n        }\n        if (!hasIncomingEnd) {\n            startIdx = i;\n            break;\n        }\n    }\n    // If no forward-oriented start, look for an edge whose end vertex is a\n    // degree-1 terminus and flip it into place.\n    let startFlipped = false;\n    if (startIdx === -1) {\n        for (let i = 0; i < infos.length; i++) {\n            const ev = edgeNodes[i].end;\n            const evTouchedElsewhere = infos.some((_, j) => j !== i &&\n                (edgeNodes[j].start === ev || edgeNodes[j].end === ev));\n            if (!evTouchedElsewhere) {\n                startIdx = i;\n                startFlipped = true;\n                break;\n            }\n        }\n    }\n    // Closed loop: no terminus. Just start from edge 0.\n    if (startIdx === -1)\n        startIdx = 0;\n    const used = new Array(infos.length).fill(false);\n    const result = [];\n    const firstEdge = startFlipped\n        ? infos[startIdx].edge.flipOrientation()\n        : infos[startIdx].edge;\n    let currentEndPoint = startFlipped\n        ? infos[startIdx].start\n        : infos[startIdx].end;\n    result.push(firstEdge);\n    used[startIdx] = true;\n    while (result.length < infos.length) {\n        let nextIdx = -1;\n        let flip = false;\n        for (let i = 0; i < infos.length; i++) {\n            if (used[i])\n                continue;\n            if (eq(infos[i].start, currentEndPoint)) {\n                nextIdx = i;\n                flip = false;\n                break;\n            }\n            if (eq(infos[i].end, currentEndPoint)) {\n                nextIdx = i;\n                flip = true;\n                break;\n            }\n        }\n        if (nextIdx === -1) {\n            throw new Error(\"Edges are not fully connected: could not find a continuation from \" +\n                `(${currentEndPoint.join(\", \")}).`);\n        }\n        const info = infos[nextIdx];\n        result.push(flip ? info.edge.flipOrientation() : info.edge);\n        currentEndPoint = flip ? info.start : info.end;\n        used[nextIdx] = true;\n    }\n    return result;\n}\n"
    },
